@startuml
left to right direction

skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 65
skinparam ranksep 80
skinparam ArrowColor #333333
skinparam ArrowThickness 1.2

skinparam usecase {
    BackgroundColor White
    BorderColor Black
}

'================================================
' ПОЛЬЗОВАТЕЛЬСКИЕ АКТОРЫ
'================================================

actor "Покупатель\n(через сайт)" as Buyer
actor "Кладовщик\n(через ТСД)" as Warehouse
actor "Оператор\nклиентского сервиса" as Operator
actor "Логист-диспетчер" as Logistic

' Вертикальное расположение акторов
Buyer -[hidden]down-> Operator
Operator -[hidden]down-> Logistic

'================================================
' ГРАНИЦА СИСТЕМЫ
'================================================

rectangle "СЛИ — система логистической интеграции" {

    '--------------------------------------------
    ' 1. ПРЕДЗАКАЗ
    '--------------------------------------------

    package "Предзаказ" {

        usecase "UC-1\nРассчитать стоимость\nдоставки" as UC1

        usecase "UC-2\nПроверить и нормализовать\nданные получателя" as UC2

        UC1 -[hidden]down-> UC2
    }

    '--------------------------------------------
    ' 2. СБОРКА И РЕГИСТРАЦИЯ
    '--------------------------------------------

    package "Сборка и регистрация" {

        usecase "UC-3\nЗарегистрировать\nотправление в ТК" as UC3

        usecase "UC-10\nПросмотреть данные\nзарегистрированного отправления" as UC10

        usecase "UC-4\nСформировать и отправить\nэтикетку ZPL на печать" as UC4

        UC3 -[hidden]down-> UC4
        UC10 -[hidden]down-> UC4
    }

    '--------------------------------------------
    ' 3. СТАТУСЫ И ОТМЕНЫ
    '--------------------------------------------

    package "Статусы и отмены" {

        usecase "UC-WH\nПринять и обработать webhook\nо смене статуса отправления" as UCWH

        usecase "UC-5\nПросмотреть статус\nдоставки" as UC5

        usecase "UC-6\nПросмотреть статус\nзаказа" as UC6

        usecase "UC-7\nОбработать отмену заказа\nдо регистрации отправления в ТК" as UC7

        usecase "UC-8\nПередать запрос на отмену\nпосле COURIER_ASSIGNED\nна ручную обработку" as UC8

        usecase "UC-9\nОбработать уведомление о неудачной\nдоставке и передать информацию логисту" as UC9

        ' Вертикальное расположение вариантов использования
        UCWH -[hidden]down-> UC5
        UC5 -[hidden]down-> UC6
        UC6 -[hidden]down-> UC7
        UC7 -[hidden]down-> UC8
        UC8 -[hidden]down-> UC9
    }

    '--------------------------------------------
    ' ПРЕДУСЛОВИЯ И ОГРАНИЧЕНИЯ
    '--------------------------------------------

    note right of UC3
      Предусловия:
      - данные заказа доступны;
      - данные получателя успешно
        прошли проверку в UC-2.
    end note

    note right of UC4
      Триггер:
      ERP передаёт событие ASSEMBLED
      после сканирования кладовщиком
      последней позиции на ТСД.

      СЛИ использует ранее полученный
      и сохранённый label_url,
      формирует ZPL и отправляет
      его на принтер Zebra.
    end note

    note right of UC7
      Отмена выполняется до вызова
      POST /orders/create.
      Отправление ещё не создано
      в системе ТК, поэтому запрос
      на отмену в API ТК не отправляется.
      СЛИ предотвращает регистрацию
      отправления и передаёт изменение
      статуса заказа в ERP.
    end note

    note right of UC8
      После COURIER_ASSIGNED
      автоматическая отмена
      не выполняется.

      Запрос передаётся
      на ручную эскалацию.
    end note

    note right of UC9
      При получении DELIVERY_FAILED:
      - статус ERP меняется на CANCELLED;
      - сохраняется cancel_reason;
      - логист получает информацию
        о неудачной доставке.
    end note

    ' Специальная обработка неудачной доставки
    ' расширяет общий сценарий обработки webhook
    UC9 ..> UCWH : <<extend>>\n[DELIVERY_FAILED]

    ' Компоновка групп
    UC2 -[hidden]down-> UC3
    UC4 -[hidden]down-> UCWH
}

'================================================
' ВНЕШНИЕ СИСТЕМЫ И УСТРОЙСТВА
'================================================

actor "ERP\n«СтройБаза-4.2»" as ERP
actor "API ТК\n«ГрузВектор v2»" as Carrier
actor "Принтер Zebra" as Printer

ERP -[hidden]down-> Carrier
Carrier -[hidden]down-> Printer

'================================================
' ПОЛЬЗОВАТЕЛЬСКИЕ СЦЕНАРИИ
'================================================

Buyer -right-> UC1
Buyer -right-> UC2
Buyer -right-> UC5
Buyer -right-> UC7

Warehouse -right-> UC4 : косвенно инициирует через ТСД и ERP

Operator -right-> UC6
Operator -right-> UC8

Logistic -right-> UC8
Logistic -right-> UC9
Logistic -right-> UC10

'================================================
' ВЗАИМОДЕЙСТВИЕ С ERP
'================================================

ERP -left-> UC1 : данные заказа
ERP -left-> UC2 : данные получателя
ERP -left-> UC3 : данные отправления

' ERP передаёт событие завершения сборки.
' Это триггер UC-4, а не передача файла печати.
ERP -left-> UC4 : событие ASSEMBLED

' ERP предоставляет данные для просмотра статусов
ERP -left-> UC5
ERP -left-> UC6
ERP -left-> UC7

' Запросы на отмену
ERP -left-> UC8
ERP -left-> UC10 : данные отправления

' СЛИ передаёт результаты обработки в ERP
UCWH -right-> ERP : обновление статуса
UC9 -right-> ERP : CANCELLED,\ncancel_reason

'================================================
' ВЗАИМОДЕЙСТВИЕ С API ТК
'================================================

' Запрос тарифа и получение результата
UC1 -right-> Carrier : запрос тарифа

' Регистрация отправления и получение результата
UC3 -right-> Carrier : POST /orders/create

' Входящие webhook-уведомления
Carrier -left-> UCWH : webhook

'================================================
' ПЕЧАТЬ ЭТИКЕТКИ
'================================================

' СЛИ самостоятельно отправляет ZPL на Zebra
UC4 -right-> Printer : ZPL

@enduml