@startuml
entity "Покупатель\n<<внешний, ERP>>" as Customer {
  * идентификатор учётной записи
  --
  личный кабинет
}
entity "Заказ\n<<внешний, ERP>>" as Order {
  * номер заказа (client_order_id)
  --
  статус
  телефон получателя (E.164)
  расчётная стоимость доставки
  комментарий для ТК
  причина отмены (cancel_reason)
}
entity "Позиция заказа\n<<внешний, ERP>>" as Item {
  * заказ + артикул
  --
  количество
}
entity "Товар\n<<внешний, ERP>>" as Product {
  * артикул
  --
  вес (г)
  длина, ширина, высота (мм), могут быть пусты
}
entity "Адрес доставки\n<<внешний, ERP>>" as Address {
  * заказ
  --
  город, улица, дом, корпус/строение, квартира
  ограничения доступа
}
entity "Отправление\n<<внешний, ТК>>" as Shipment {
  * gv_tracking_number (выдан ТК)
  --
  статус ТК
  количество грузовых мест
  label_url
}
entity "Событие ТК" as Event {
  * идентификатор события в очереди
  --
  новый статус
  время события
  комментарий ТК
}
entity "Задача оператору" as Task {
  * номер задачи
  --
  тип (регистрация, ошибка валидации, отмена, возврат)
  исполнитель (роль)
  статус
}
Customer ||--o{ Order : оформляет
Order ||--|{ Item : содержит
Item }o--|| Product : ссылается на
Order ||--|| Address : доставка по
Order ||--o| Shipment : регистрируется,\nесли не отменён до передачи
Shipment ||--o{ Event : получает
Order ||--o{ Task : порождает
@enduml